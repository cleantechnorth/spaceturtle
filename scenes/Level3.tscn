[gd_scene load_steps=5 format=3 uid="uid://level3001"]

[ext_resource type="Script"      path="res://scripts/level3.gd"         id="1_level3"]
[ext_resource type="PackedScene" uid="uid://player001"  path="res://scenes/Player.tscn"      id="2_player"]
[ext_resource type="PackedScene" uid="uid://petalboss001" path="res://scenes/PetalBoss.tscn"   id="3_boss"]
[ext_resource type="PackedScene" uid="uid://shield001"  path="res://scenes/ShieldPickup.tscn" id="4_shield"]

; ── Scene tree ──────────────────────────────────────────────────────────────
; Level3 (Node2D)            ← root, runs level3.gd, draws Petal Fields bg
;   Player                   ← the turtle (same as all levels)
;   PetalBoss                ← the flower boss (swaying at top-centre)
;   ShieldPickup             ← brass shield sitting in the lower arena
;   Attacks (Node2D)         ← runtime container for petal-attack projectiles
;   Gears   (Node2D)         ← runtime container for boss-drop gears
;   UI (CanvasLayer)
;     ScoreLabel             ← "Gears: 0 / 3"
;     BossHPLabel            ← "Boss: ❤ ❤ ❤"
;     HintLabel              ← contextual hint text (bottom-centre)

[node name="Level3" type="Node2D"]
script = ExtResource("1_level3")

; Player starts lower-centre so they have room to dodge
[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector2(512.0, 420.0)

; Boss hovers near the top-centre of the screen
[node name="PetalBoss" parent="." instance=ExtResource("3_boss")]
position = Vector2(512.0, 145.0)

; Shield sits in the centre of the arena, easy to spot
[node name="ShieldPickup" parent="." instance=ExtResource("4_shield")]
position = Vector2(300.0, 360.0)

; Runtime containers
[node name="Attacks" type="Node2D" parent="."]
[node name="Gears"   type="Node2D" parent="."]

; HUD
[node name="UI" type="CanvasLayer" parent="."]

; Gear counter – top-left
[node name="ScoreLabel" type="Label" parent="UI"]
offset_left   = 20.0
offset_top    = 20.0
offset_right  = 280.0
offset_bottom = 56.0
text = "Gears: 0 / 3"
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color    = Color(1.0, 1.0, 1.0, 1.0)

; Boss HP – top-right
[node name="BossHPLabel" type="Label" parent="UI"]
anchor_left   = 1.0
anchor_right  = 1.0
offset_left   = -280.0
offset_top    = 20.0
offset_right  = -20.0
offset_bottom = 56.0
text = "Boss: ❤ ❤ ❤"
horizontal_alignment = 2
theme_override_font_sizes/font_size = 24
theme_override_colors/font_color    = Color(1.0, 0.35, 0.55, 1.0)

; Hint text – bottom-centre
[node name="HintLabel" type="Label" parent="UI"]
anchor_left   = 0.5
anchor_right  = 0.5
anchor_bottom = 1.0
anchor_top    = 1.0
offset_left   = -300.0
offset_top    = -70.0
offset_right  =  300.0
offset_bottom = -16.0
text = "Dodge attacks!\nFind the shield!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color    = Color(1.0, 0.90, 0.40, 1.0)
