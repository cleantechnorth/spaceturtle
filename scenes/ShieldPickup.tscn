[gd_scene load_steps=4 format=3 uid="uid://shield001"]

[ext_resource type="Script"    path="res://scripts/shield_pickup.gd" id="1_shield"]
[ext_resource type="Texture2D" path="res://assets/shield.svg"        id="2_shield"]

[sub_resource type="CircleShape2D" id="CircleShape2D_1"]
radius = 20.0

; ── Scene tree ──────────────────────────────────────────────────────────────
; ShieldPickup (Area2D)      ← collectible shield; runs shield_pickup.gd
;   CollisionShape2D         ← circle for player overlap detection
;   Sprite2D                 ← shield.svg (48×48, centred)

[node name="ShieldPickup" type="Area2D"]
script = ExtResource("1_shield")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_1")

[node name="Sprite2D" type="Sprite2D" parent="."]
texture = ExtResource("2_shield")
