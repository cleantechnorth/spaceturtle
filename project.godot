; Engine configuration file.
; Generated for SpaceTurtle – a kid-friendly Godot 4 game.
config_version=5

[application]
config/name="SpaceTurtle"
config/description="A steampunk space turtle collects gears and avoids asteroids!"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[display]
window/size/viewport_width=1024
window/size/viewport_height=600

[rendering]
environment/defaults/default_clear_color=Color(0.04, 0.02, 0.1, 1)

[autoload]
TurtleSettings="*res://scripts/turtle_settings.gd"

